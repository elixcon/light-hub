# The node - see CMakeLists.txt. The radio and rollback settings are the hub's,
# for the hub's reasons; sdkconfig.defaults in the project root explains each.
CONFIG_IDF_TARGET="esp32c6"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Zigbee end device, on the native 802.15.4 radio.
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZED=y

# Wi-Fi runs only for configuration, but when it runs it shares the antenna.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_LWIP_IPV6=n
CONFIG_ESP_PHY_RF_CAL_FULL=y
CONFIG_LWIP_DHCP_DOES_NOT_CHECK_OFFERED_IP=y
CONFIG_LWIP_LOCAL_HOSTNAME="light-node"

# Half the hub's clock. No frequency scaling: going below 80 MHz could stop the
# PLL that clocks the PWM. Not power management's doing, so no locks to take.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

CONFIG_HTTPD_MAX_URI_LEN=256
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

CONFIG_ESP_MAIN_TASK_STACK_SIZE=5120
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Three lights and the control endpoint: the hub stores four endpoints a device.
CONFIG_ZBC_MAX_LIGHTS=3
CONFIG_ZBC_MAX_BUTTONS=8
